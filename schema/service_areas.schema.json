{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAVFS 1.0 service_areas",
  "type": "object",
  "required": [
    "last_updated",
    "data"
  ],
  "properties": {
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "service_areas"
      ],
      "properties": {
        "service_areas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "area_id",
              "name",
              "geometry",
              "pickup_allowed",
              "dropoff_allowed",
              "has_surge"
            ],
            "properties": {
              "area_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  },
                  "coordinates": {
                    "type": "array",
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              },
              "pickup_allowed": {
                "type": "boolean"
              },
              "dropoff_allowed": {
                "type": "boolean"
              },
              "has_surge": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
