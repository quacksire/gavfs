{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAVFS 1.0 service_status",
  "type": "object",
  "required": [
    "last_updated",
    "data"
  ],
  "properties": {
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "operating",
            "limited",
            "suspended"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
