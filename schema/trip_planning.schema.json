{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAVFS 1.0 trip_planning",
  "type": "object",
  "required": [
    "last_updated",
    "data"
  ],
  "properties": {
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "trips"
      ],
      "properties": {
        "trips": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "product_id",
              "pickup_eta_seconds",
              "duration_seconds",
              "fare",
              "booking"
            ],
            "properties": {
              "trip_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string",
                "minLength": 1
              },
              "pickup_eta_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "duration_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "distance_meters": {
                "type": "number",
                "minimum": 0
              },
              "pickup": {
                "type": "object",
                "required": [
                  "lat",
                  "lon"
                ],
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "additionalProperties": false
              },
              "dropoff": {
                "type": "object",
                "required": [
                  "lat",
                  "lon"
                ],
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "additionalProperties": false
              },
              "fare": {
                "type": "object",
                "required": [
                  "currency",
                  "type"
                ],
                "properties": {
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "type": {
                    "enum": [
                      "estimated",
                      "estimated_range",
                      "guaranteed"
                    ]
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minimum": {
                    "type": "number",
                    "minimum": 0
                  },
                  "maximum": {
                    "type": "number",
                    "minimum": 0
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "enum": [
                            "estimated",
                            "guaranteed"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "amount"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "estimated_range"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "minimum",
                        "maximum"
                      ]
                    }
                  }
                ],
                "additionalProperties": false
              },
              "booking": {
                "type": "object",
                "required": [
                  "deep_link"
                ],
                "properties": {
                  "deep_link": {
                    "type": "string",
                    "format": "uri"
                  },
                  "web_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "app_store_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "play_store_url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
